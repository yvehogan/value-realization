# Copy to .env (or .env.local) and adjust for your environment.

# Nexus API base URL, including the version segment (no trailing slash).
# Server-side only: the browser never sees it; calls go through /api/nexus.
# Swagger: https://www.nexus-api.somee.com/swagger/index.html
NEXUS_API_URL=https://www.nexus-api.somee.com/api/v1
